{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Setup venv",
      "type": "shell",
      "windows": {
        "command": "if (-not (Test-Path .venv\\Scripts\\python.exe)) { python -m venv .venv }; .venv\\Scripts\\python.exe -m pip install -q -r requirements.txt"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Backend",
      "type": "shell",
      "windows": {
        "command": ".venv\\Scripts\\python.exe run_server.py"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "dependsOn": ["Backend: Setup venv"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm run tauri:dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Build backend exe",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build-backend.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
