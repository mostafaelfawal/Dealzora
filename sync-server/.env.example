# إعدادات سيرفر المزامنة. انسخه:  cp .env.example .env  واملأ القيم.
# نفس الملف بالظبط للتشغيل المؤقت (Cloudflare Tunnel) وللـ VPS بعدين: لا تغيّر الأسرار وقت النقل
# (تغييرها = كل الفروع والهواتف تحتاج ربط من جديد). لا ترفع .env على git أبداً.

# ---------- الدومين (لازم) ----------
SYNC_DOMAIN=sync.yourdomain.com
# إيميلك: Let's Encrypt يبعتلك عليه لو فيه مشكلة في شهادة HTTPS (على الـ VPS)
ACME_EMAIL=you@example.com

# ---------- قاعدة البيانات (لازم) ----------
POSTGRES_DB=dealzora_sync
POSTGRES_USER=dealzora
# openssl rand -hex 24
POSTGRES_PASSWORD=
# النسخ الاحتياطي اليومي في ./backups: تُحذف النسخ الأقدم من كام يوم
BACKUP_KEEP_DAYS=14

# ---------- الأسرار (لازم، 32 حرف على الأقل) ----------
# openssl rand -hex 32
SYNC_JWT_SECRET=
# openssl rand -hex 32  (للوحة الإدارة: لك أنت فقط)
SYNC_ADMIN_TOKEN=

# ---------- التراخيص ----------
# المفتاح العام لتوقيع التراخيص = نفس DEALZORA_VENDOR_PUBKEY في بناء البرنامج.
# فارغ = المالك مش هيقدر يسجّل محله بنفسه (المحلات من أوامر الإدارة فقط)
SYNC_VENDOR_PUBKEY=
# شهادة الفروع (ترث خطة المحل): python -m app.cli lease-keygen
# الخاص هنا (سري)، والعام في بناء البرنامج (DEALZORA_SYNC_LEASE_PUBKEY)
SYNC_LEASE_KEY=

# ---------- الأمان ----------
# لوحة الإدارة عبر الـ API: 127.0.0.1 = مقفولة من الإنترنت (استخدم أوامر app.cli من على الجهاز نفسه).
# فارغ = أي IP بشرط SYNC_ADMIN_TOKEN
SYNC_ADMIN_ALLOWED_IPS=127.0.0.1
# صفحة /docs: false على السيرفر الحقيقي
SYNC_DOCS_ENABLED=false
# عدد عمليات السيرفر (2 كفاية لـ 1–2 GB رام)
SYNC_WORKERS=2

# ---------- Cloudflare Tunnel (التشغيل المؤقت فقط، README قسم 1-ب) ----------
# التوكن من: Zero Trust ← Networks ← Tunnels ← النفق. امسحه بعد النقل للـ VPS
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- اختياري ----------
# لو فعّلت «Enhanced security for push notifications» في expo.dev
SYNC_EXPO_ACCESS_TOKEN=
