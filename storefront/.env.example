# عنوان سيرفر الفروع من داخل الشبكة (للصفحات التي تُبنى على السيرفر). في docker compose: http://api:8000
STORE_API_INTERNAL_URL=http://localhost:8001
# التطوير فقط: تمرير طلبات المتصفح /v1/store/public/* لسيرفر الفروع (في الإنتاج Caddy يوجّهها مباشرة).
STORE_DEV_PROXY=1
# العنوان العام للمتجر (روابط المشاركة وبيانات محركات البحث). نفس SYNC_STORE_PUBLIC_URL في سيرفر الفروع.
NEXT_PUBLIC_STORE_URL=http://localhost:3000
