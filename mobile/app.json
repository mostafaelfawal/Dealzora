{
  "expo": {
    "name": "Dealzora سلسلة",
    "slug": "dealzora-mobile",
    "scheme": "dealzora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dealzora.chain",
      "infoPlist": {
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": ["ar"]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.dealzora.chain",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/brand/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": ["ar"]
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "يستخدم Dealzora بصمة الوجه لفتح التطبيق"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم Dealzora بصمة الوجه لفتح التطبيق"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/brand/logo.png",
          "imageWidth": 120
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#171717",
          "defaultChannel": "alerts",
          "icon": "./assets/brand/notification-icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": true,
      "forcesRTL": true,
      "eas": {
        "projectId": "3795e361-7ab4-4893-94b7-7b5a3b416854"
      }
    },
    "owner": "mostafa_hamdi_elfawal",
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/brand/logo.png"
    }
  }
}
