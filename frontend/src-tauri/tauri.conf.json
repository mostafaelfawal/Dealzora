{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dealzora",
  "version": "1.0.9",
  "identifier": "com.dealzora.pos",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dealzora",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/dealzora-backend"
    ],
    "active": true,
    "copyright": "© 2026 Dealzora",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "uninstallerHeaderImage": "windows/header.bmp",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFMjY0RDMwOTg0ODc2NTYKUldSV2RraVlNRTBtN2poRXowVDBaNDU2YjlJcnNPVWNTWTQxdE4wQndtd043aWlnbmR5bkRFRjIK",
      "endpoints": [
        "https://github.com/mostafaelfawal/Dealzora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
